// Per pixel: integrate the cosine-weighted irradiance from the four nearest cascade-0 probes
// (depth-weighted) and add it to the scene colour.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 2, rgba16f) uniform restrict image2D color_img;
layout(set = 0, binding = 3, rgba16f) uniform restrict readonly image2D c0_img;

layout(push_constant, std430) uniform Gather {
	vec4 a; // a_0, unused, unused, unused
} pc;

vec3 pos_at(ivec2 p) {
	ivec2 q = clamp(p, ivec2(0), ivec2(P.screen.xy) - 1);
	return view_pos(q, texelFetch(depth_tex, q, 0).r);
}

vec3 normal_at(ivec2 p, vec3 pc_pos) {
	vec3 xp = pos_at(p + ivec2(1, 0));
	vec3 xm = pos_at(p - ivec2(1, 0));
	vec3 yp = pos_at(p + ivec2(0, 1));
	vec3 ym = pos_at(p - ivec2(0, 1));
	vec3 dx = abs(xp.z - pc_pos.z) < abs(xm.z - pc_pos.z) ? xp - pc_pos : pc_pos - xm;
	vec3 dy = abs(yp.z - pc_pos.z) < abs(ym.z - pc_pos.z) ? yp - pc_pos : pc_pos - ym;
	vec3 n = normalize(cross(dx, dy));
	return dot(n, pc_pos) > 0.0 ? -n : n;
}

vec3 irradiance(ivec2 probe, int a0, vec3 n) {
	vec3 acc = vec3(0.0);
	float wsum = 0.0;
	for (int j = 0; j < a0; j++) {
		for (int i = 0; i < a0; i++) {
			vec3 v = oct_vec(ivec2(i, j), a0);
			float w = pow(dot(v, v), -1.5);
			float c = max(dot(normalize(v), n), 0.0);
			acc += imageLoad(c0_img, probe * a0 + ivec2(i, j)).rgb * (c * w);
			wsum += w;
		}
	}
	return 4.0 * acc / wsum;
}

void main() {
	ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	ivec2 sz = ivec2(P.screen.xy);
	if (any(greaterThanEqual(p, sz))) {
		return;
	}
	float d = texelFetch(depth_tex, p, 0).r;
	if (d <= SKY_DEPTH) {
		return;
	}
	vec3 pos = view_pos(p, d);
	float depth = -pos.z;
	vec3 n = normal_at(p, pos);

	int a0 = int(pc.a.x + 0.5);
	float scale = P.misc.x;
	ivec2 grid = ivec2(P.screen.zw) / a0;
	vec2 g = (vec2(p) + 0.5) / scale;
	vec2 qf = g / float(a0) - 0.5;
	ivec2 q0 = ivec2(floor(qf));
	vec2 fr = qf - vec2(q0);

	vec3 acc = vec3(0.0);
	float wsum = 0.0;
	for (int k = 0; k < 4; k++) {
		ivec2 o = ivec2(k & 1, k >> 1);
		ivec2 qp = q0 + o;
		if (any(lessThan(qp, ivec2(0))) || any(greaterThanEqual(qp, grid))) {
			continue;
		}
		ivec2 pp = ivec2((vec2(qp) + 0.5) * float(a0) * scale);
		if (any(greaterThanEqual(pp, sz))) {
			continue;
		}
		float dd = texelFetch(depth_tex, pp, 0).r;
		if (dd <= SKY_DEPTH) {
			continue;
		}
		float bw = (o.x == 1 ? fr.x : 1.0 - fr.x) * (o.y == 1 ? fr.y : 1.0 - fr.y);
		float dz = (lin_depth(dd) - depth) / (0.05 * depth + 0.03);
		float w = bw * (exp(-dz * dz) + 0.001);
		acc += w * irradiance(qp, a0, n);
		wsum += w;
	}
	vec3 gi = wsum > 0.0 ? acc / wsum : vec3(0.0);

	vec4 col = imageLoad(color_img, p);
	float luma = dot(col.rgb, vec3(0.2126, 0.7152, 0.0722));
	vec3 albedo = luma > 1e-4 ? clamp(col.rgb / luma * P.tune.y, 0.0, 1.0) : vec3(P.tune.y);
	vec3 indirect = gi * albedo * P.tune.x;
	if (P.tune.w > 0.5) {
		col.rgb = indirect;
	} else {
		col.rgb += indirect;
	}
	imageStore(color_img, p, col);
}
