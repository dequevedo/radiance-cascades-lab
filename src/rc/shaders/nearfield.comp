// Per pixel, one short ray (up to the near range) in the direction given by the pixel's place in a 4x4 tile.
// The ray is marched through the voxels as a soft density field (trilinear occupancy, front-to-back), not as
// "first solid voxel": the edge of a voxel step becomes a one-voxel ramp, so the staircase of a curved wall or
// of a moving box does not show up as a zigzag in the light. What the ray does not absorb is the same direction
// read from the nearest world probes, whose rays start where this one ends. Also stores the world normal
// and linear depth.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 1, rgba8) uniform restrict readonly image3D vox_albedo;
layout(set = 0, binding = 8) uniform sampler2D depth_tex;
layout(set = 0, binding = 9, rgba16f) uniform restrict readonly image2D color_img; // the lit picture (sharp reflections)
layout(set = 0, binding = 24, rgba16f) uniform restrict readonly image2D prev_img; // last frame's finished picture
layout(set = 0, binding = 10, rgba16f) uniform restrict readonly image3D c0_img;
layout(set = 0, binding = 12, rgba16f) uniform restrict writeonly image2D near_img;
layout(set = 0, binding = 13, rgba16f) uniform restrict writeonly image2D nrm_img;
layout(set = 0, binding = 17, rgba16f) uniform restrict writeonly image2D spec_img; // glossy reflection from the probes (rgb), metallic (a)
layout(set = 0, binding = 18) uniform sampler3D mat_tex; // per voxel: metallic, roughness
layout(set = 0, binding = 19) uniform sampler3D base_tex; // per voxel: base colour
layout(set = 0, binding = 14) uniform sampler3D occ_tex; // static voxels, trilinear: alpha = occupancy 0..1
layout(set = 0, binding = 25) uniform sampler3D dyn_mask; // coarse cells a moving object touches
layout(set = 0, binding = 16) uniform sampler3D dyn_tex; // moving objects only (their own volume), trilinear: alpha = coverage 0..1
layout(set = 0, binding = 22) uniform sampler2D smooth_tex; // Godot's normal_roughness: view-space normal * 0.5 + 0.5, interpolated across triangles
layout(set = 0, binding = 23) uniform sampler3D tint_tex; // see-through voxels: the colour they let through (voxelize_mesh.comp)
layout(set = 0, binding = 21) uniform sampler3D nrm_tex; // surface normal per voxel (inject.comp)
layout(set = 0, binding = 15) uniform sampler3D rad_tex; // vox_rad, trilinear: rgb premultiplied by alpha (= surface voxel weight)

layout(push_constant, std430) uniform Near {
	vec4 a; // a_0 (directions per axis of cascade 0), directions per axis of the per-pixel tile, tile shift x, tile shift y
} pc;

//#include trace.inc
//#include screen.inc

// Coverage of the moving objects. Their volume is empty outside their bounds (padded by 0.3 m), so most samples skip the read.
float dyn_occ(vec3 pos, vec3 uvw) {
	if (any(lessThan(pos, P.dyn_min.xyz)) || any(greaterThan(pos, P.dyn_max.xyz))) {
		return 0.0;
	}
	// Inside the bounds of all of them (in a city, most of the volume when cars are spread out): a coarse mask of the cells they
	// really touch, a tiny texture that stays in the cache.
	ivec3 mc = ivec3((pos - P.vol_min.xyz) / P.glass_max.w);
	if (texelFetch(dyn_mask, clamp(mc, ivec3(0), textureSize(dyn_mask, 0) - 1), 0).r < 0.5) {
		return 0.0;
	}
	return textureLod(dyn_tex, uvw, 0.0).a;
}

// Coloured glass: the voxels of a see-through surface hold the colour it lets through. Multiplying by
// pow(colour, coverage * step / voxel) colours a ray once per pane, however its samples fall on the pane.
vec3 glass_filter(vec3 pos, vec3 uvw, float step_len) {
	if (P.glass_min.w < 0.5 || any(lessThan(pos, P.glass_min.xyz)) || any(greaterThan(pos, P.glass_max.xyz))) {
		return vec3(1.0);
	}
	vec4 g = textureLod(tint_tex, uvw, 0.0);
	if (g.a < 0.01) {
		return vec3(1.0);
	}
	return pow(clamp(g.rgb / g.a, vec3(0.02), vec3(1.0)), vec3(g.a * step_len / P.vol_min.w));
}

// How much of a surface voxel's light a ray travelling along dir sees: the light leaves the side the surface faces (the normal
// inject.comp found), so a voxel seen from behind, or the edge of a glowing screen seen from behind the set, gives none.
float facing_weight(vec3 uvw, vec3 dir) {
	if ((int(P.screen.w + 0.5) & 16) == 0) {
		return 1.0;
	}
	vec3 ns = textureLod(nrm_tex, uvw, 0.0).xyz;
	float l = length(ns);
	return l > 0.05 ? smoothstep(-0.15, 0.25, dot(-dir, ns / l)) : 1.0;
}

// A cheap per-pixel random number in [0, 1).
float hash12(vec2 q) {
	vec3 p3 = fract(vec3(q.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

// The same direction (ij) of cascade 0, blended over the 8 probes around the point (sharp facing weight, no ray test).
vec3 probe_blend(vec3 pw, vec3 nw, ivec2 ij, int a0, vec3 jitter) {
	float sp = P.misc.x;
	ivec3 grid = grid_of(sp);
	vec3 start = pw + nw * P.misc.z + jitter;
	vec3 qf = (start - P.vol_min.xyz) / sp - 0.5;
	ivec3 q0 = ivec3(floor(qf));
	vec3 fr = qf - vec3(q0);
	vec3 acc = vec3(0.0);
	float ws = 0.0;
	for (int k = 0; k < 8; k++) {
		ivec3 o = ivec3(k & 1, (k >> 1) & 1, k >> 2);
		ivec3 qp = q0 + o;
		if (any(lessThan(qp, ivec3(0))) || any(greaterThanEqual(qp, grid))) {
			continue;
		}
		vec3 qpos = P.vol_min.xyz + (vec3(qp) + 0.5) * sp;
		// How open the probe is, as a smooth number: a moving object covering it fades it out instead of switching it off.
		vec3 quvw = (qpos - P.vol_min.xyz) / (P.vol_dims.xyz * P.vol_min.w);
		float open = 1.0 - clamp(max(textureLod(occ_tex, quvw, 0.0).a, dyn_occ(qpos, quvw)), 0.0, 1.0);
		float bw = (o.x == 1 ? fr.x : 1.0 - fr.x) * (o.y == 1 ? fr.y : 1.0 - fr.y) * (o.z == 1 ? fr.z : 1.0 - fr.z);
		float face = dot(normalize(qpos - pw), nw);
		float w = bw * open * (pow((face + 1.0) * 0.5, 4.0) + 0.01);
		acc += w * imageLoad(c0_img, ivec3(qp.x * a0 + ij.x, qp.y * a0 + ij.y, qp.z)).rgb;
		ws += w;
	}
	return ws > 0.0 ? acc / ws : vec3(0.0);
}

// A direction cell just outside the octahedral map is the mirrored cell on the same border (the map folds there), so a blend
// across the border is continuous instead of clamping (which drew a seam across a reflection where its direction crosses it).
ivec2 oct_wrap(ivec2 ij, int n) {
	if (ij.x < 0) {
		ij = ivec2(0, n - 1 - ij.y);
	} else if (ij.x >= n) {
		ij = ivec2(n - 1, n - 1 - ij.y);
	}
	if (ij.y < 0) {
		ij = ivec2(n - 1 - ij.x, 0);
	} else if (ij.y >= n) {
		ij = ivec2(n - 1 - ij.x, n - 1);
	}
	return clamp(ij, ivec2(0), ivec2(n - 1));
}

// The same as probe_blend for any direction: the 4 nearest directions of the probes' octahedral grid, blended bilinearly, so a
// reflection turns smoothly instead of jumping between the 16 directions a probe of cascade 0 holds.
vec3 probe_blend_dir(vec3 pw, vec3 nw, vec3 d, int a0) {
	vec2 q = d.xy / (abs(d.x) + abs(d.y) + abs(d.z));
	if (d.z < 0.0) {
		q = (1.0 - abs(q.yx)) * sign(q.xy);
	}
	vec2 g = (q * 0.5 + 0.5) * float(a0) - 0.5;
	ivec2 i0 = ivec2(floor(g));
	vec2 f = g - vec2(i0);
	vec3 acc = vec3(0.0);
	for (int k = 0; k < 4; k++) {
		ivec2 o = ivec2(k & 1, k >> 1);
		ivec2 ij = oct_wrap(i0 + o, a0);
		float w = (o.x == 1 ? f.x : 1.0 - f.x) * (o.y == 1 ? f.y : 1.0 - f.y);
		acc += w * probe_blend(pw, nw, ij, a0, vec3(0.0));
	}
	return acc;
}

// A reflection traced through the voxels (for what the picture does not show: behind the camera, behind something, off the
// edges): the first surface along the ray, as blocky as the voxels but sharper than the probes. rgb and how much was hit.
vec4 voxel_reflection(vec3 o, vec3 d) {
	float vs = P.vol_min.w;
	vec3 extent = P.vol_dims.xyz * vs;
	vec3 L = vec3(0.0);
	vec3 Tc = vec3(1.0);
	float T = 1.0;
	float t = vs * 1.5;
	for (int i = 0; i < 56 && T > 0.03; i++) {
		vec3 pos = o + d * t;
		vec3 uvw = (pos - P.vol_min.xyz) / extent;
		if (any(lessThan(uvw, vec3(0.0))) || any(greaterThan(uvw, vec3(1.0)))) {
			break;
		}
		float step_len = vs * (0.8 + float(i) * 0.06);
		Tc *= glass_filter(pos, uvw, step_len);
		float occ = max(textureLod(occ_tex, uvw, 0.0).a, dyn_occ(pos, uvw));
		if (occ > 0.01) {
			vec4 r = textureLod(rad_tex, uvw, 0.0);
			vec3 surf = r.a > 0.01 ? r.rgb / r.a : vec3(0.0);
			float a = clamp(occ * OCC_GAIN, 0.0, 1.0);
			L += T * Tc * a * min(surf, vec3(P.tune.z)) * facing_weight(uvw, d);
			T *= 1.0 - a;
		}
		t += step_len;
	}
	return vec4(L, 1.0 - T);
}

// A sharp reflection from the picture itself: the mirror ray is marched in view space until it passes behind what the depth
// buffer shows, and the colour there is the reflection. rgb, and how much to trust it (0 = not found: off screen, hidden,
// or pointing back at the camera). Rough surfaces keep the probes' blurred reflection instead.
vec4 screen_reflection(vec3 vpos, vec3 vn, vec3 rv, float seed) {
	if (rv.z > 0.7) {
		return vec4(0.0);
	}
	vec3 o = vpos + vn * 0.01;
	float t = 0.02 + 0.03 * seed;
	float t_prev = 0.0;
	bool hit = false;
	for (int i = 0; i < 40; i++) {
		vec3 q = o + rv * t;
		if (q.z > -0.05) {
			break;
		}
		vec4 c = P.proj * vec4(q, 1.0);
		vec2 uv = c.xy / c.w * 0.5 + 0.5;
		if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) {
			break;
		}
		ivec2 px = ivec2(uv * P.screen.xy);
		float d = texelFetch(depth_tex, px, 0).r;
		float behind = view_pos(px, d).z - q.z; // > 0: the surface in the picture is in front of the ray
		if (d > SKY_DEPTH && behind > 0.0) {
			if (behind < 0.06 + t * 0.08) {
				hit = true;
			}
			break;
		}
		t_prev = t;
		t += 0.02 + t * 0.12;
	}
	if (!hit) {
		return vec4(0.0);
	}
	// Refine between the last point in front and the first behind.
	float lo = t_prev;
	float hi = t;
	for (int k = 0; k < 5; k++) {
		float mid = (lo + hi) * 0.5;
		vec3 q = o + rv * mid;
		vec4 c = P.proj * vec4(q, 1.0);
		ivec2 px = ivec2(clamp(c.xy / c.w * 0.5 + 0.5, vec2(0.0), vec2(0.9999)) * P.screen.xy);
		if (view_pos(px, texelFetch(depth_tex, px, 0).r).z - q.z > 0.0) {
			hi = mid;
		} else {
			lo = mid;
		}
	}
	vec4 c = P.proj * vec4(o + rv * hi, 1.0);
	vec2 uv = c.xy / c.w * 0.5 + 0.5;
	ivec2 px = ivec2(clamp(uv, vec2(0.0), vec2(0.9999)) * P.screen.xy);
	vec2 edge = min(uv, 1.0 - uv);
	float conf = smoothstep(0.0, 0.08, min(edge.x, edge.y)) * (1.0 - smoothstep(0.3, 0.7, rv.z));
	// A metal in the picture is nearly black (Godot draws it with no reflections of its own): there the probes do better.
	// The colour comes from last frame's finished picture, reprojected: it has the bounce light, and a metal in it shows its own
	// reflection (in this frame's picture, before the effect, Godot draws a metal nearly black).
	if ((int(P.screen.w + 0.5) & 64) != 0) {
		vec3 hw = (P.cam_to_world * vec4(view_pos(px, texelFetch(depth_tex, px, 0).r), 1.0)).xyz;
		vec4 pc4 = P.prev_vp * vec4(hw, 1.0);
		vec2 puv = pc4.xy / pc4.w * 0.5 + 0.5;
		if (pc4.w > 0.0 && all(greaterThanEqual(puv, vec2(0.0))) && all(lessThan(puv, vec2(1.0)))) {
			return vec4(imageLoad(prev_img, ivec2(puv * P.screen.xy)).rgb, conf);
		}
	}
	return vec4(imageLoad(color_img, px).rgb, conf);
}

void main() {
	ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(p, ivec2(P.screen.xy)))) {
		return;
	}
	float d = texelFetch(depth_tex, p, 0).r;
	if (d <= SKY_DEPTH) {
		imageStore(near_img, p, vec4(0.0));
		imageStore(nrm_img, p, vec4(0.0));
		imageStore(spec_img, p, vec4(0.0));
		return;
	}
	vec3 vpos = view_pos(p, d);
	vec3 pw = (P.cam_to_world * vec4(vpos, 1.0)).xyz;
	vec3 nw = normalize(mat3(P.cam_to_world) * normal_view(p, vpos));
	imageStore(nrm_img, p, vec4(nw, -vpos.z));

	int a0 = int(pc.a.x + 0.5);
	int na = int(pc.a.y + 0.5);
	ivec2 shift = ivec2(int(pc.a.z + 0.5), int(pc.a.w + 0.5)); // changes every frame, so a pixel sees other directions next time
	vec3 dir = normalize(oct_vec(ivec2((p.x + shift.x) % na, (p.y + shift.y) % na), na));
	ivec2 ij = oct_texel(dir, a0); // the same direction in the probes (coarser grid)
	vec3 rad = vec3(0.0);
	// Jitter (A): the ray's samples start at a random point of their first step, and the probes are read from a point moved
	// sideways at random, a new draw every frame. A fixed sampling pattern lines up with the voxel and probe grids and draws
	// their straight lines into the light; a random one turns them into noise that the temporal blend averages away.
	bool jitter = (int(P.screen.w + 0.5) & 1) != 0;
	vec2 seed = vec2(p) + pc.a.zw * 17.31;
	float j0 = jitter ? hash12(seed) : 0.5;
	vec3 pj = vec3(0.0);
	if (jitter) {
		vec3 t1 = normalize(cross(nw, abs(nw.y) < 0.9 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0)));
		vec3 t2 = cross(nw, t1);
		pj = (t1 * (hash12(seed + 3.7) - 0.5) + t2 * (hash12(seed + 9.1) - 0.5)) * P.misc.x * 0.5;
	}
	// Directions at or below the surface get no weight in the gather, so they are not traced.
	if (dot(dir, nw) > 0.15) {
		float vs = P.vol_min.w;
		vec3 o = pw + nw * vs * 1.6;
		const int STEPS = 14;
		float step_len = P.extra.x / float(STEPS);
		vec3 extent = P.vol_dims.xyz * vs;
		float T = 1.0;
		vec3 Tc = vec3(1.0); // colour picked up crossing glass
		for (int i = 0; i < STEPS && T > 0.02; i++) {
			vec3 pos = o + dir * ((float(i) + j0) * step_len);
			vec3 uvw = (pos - P.vol_min.xyz) / extent;
			if (any(lessThan(uvw, vec3(0.0))) || any(greaterThan(uvw, vec3(1.0)))) {
				break;
			}
			Tc *= glass_filter(pos, uvw, step_len);
			float occ = max(textureLod(occ_tex, uvw, 0.0).a, dyn_occ(pos, uvw));
			if (occ > 0.01) {
				vec4 r = textureLod(rad_tex, uvw, 0.0);
				vec3 surf = r.a > 0.01 ? r.rgb / r.a : vec3(0.0);
				float a = clamp(occ * OCC_GAIN, 0.0, 1.0);
				// The voxel copy of a surface that is not aligned with the grid is a staircase that sticks out of the real
				// surface by up to a voxel; in the first 1.5 voxels of the ray, occupancy fades in, so a pixel does not
				// shadow itself with its own staircase (a band of dark steps along the bottom of a turned box).
				if (jitter) {
					a *= clamp(((float(i) + j0) * step_len) / (vs * 1.5), 0.0, 1.0);
				}
				rad += T * Tc * a * min(surf, vec3(P.tune.z)) * facing_weight(uvw, dir);
				T *= 1.0 - a;
			}
		}
		if (T > 0.02) {
			rad += T * Tc * probe_blend(pw, nw, ij, a0, pj);
		}
	}
	imageStore(near_img, p, vec4(rad, 1.0));

	// Glossy reflection: the light the probes around this point receive from the mirror direction. The probes of cascade 0 hold
	// 4 x 4 directions, so this is a blurred reflection: right for satin and brushed surfaces, too soft for a mirror (Godot's own
	// screen-space reflections, an option in the panel, handle sharp ones). The material comes from the voxel under the pixel.
	// The surface voxel under the pixel: the first marked one a little inside the surface.
	vec4 m = vec4(0.0);
	vec3 muvw = vec3(0.0);
	// The search starts on the surface: a point already 2.5 cm inside lands in the inside of the object (solid but with no
	// material) wherever a facet runs close to a voxel boundary, and the whole facet came out black on a metal.
	// Not exactly on it either: a floor at a voxel boundary would find one layer or the other as the picture jitters, and its
	// sheen would blink on and off.
	const float LOOKUP[5] = float[5](0.05, 0.25, -0.15, 0.45, 0.8);
	for (int k = 0; k < 5 && m.a < 0.5; k++) {
		muvw = (pw - nw * P.vol_min.w * LOOKUP[k] - P.vol_min.xyz) / (P.vol_dims.xyz * P.vol_min.w);
		m = textureLod(mat_tex, muvw, 0.0);
	}
	float metallic = m.a > 0.5 ? m.r : 0.0;
	float rough = m.a > 0.5 ? m.g : 1.0;
	// Roughness per pixel, from Godot's normal_roughness buffer: it has the roughness textures (the asphalt's puddles), where a
	// voxel has one value per surface. Godot keeps it in [0, 127/255] and flips it for moving objects.
	if ((int(P.screen.w + 0.5) & 512) != 0) {
		float rw = texelFetch(smooth_tex, p, 0).a;
		if (rw > 0.5) {
			rw = 1.0 - rw;
		}
		rough = clamp(rw / (127.0 / 255.0), 0.0, 1.0);
	}
	vec3 spec = vec3(0.0);
	if (rough < 0.85) {
		vec3 cam = (P.cam_to_world * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
		vec3 v = normalize(cam - pw);
		// The reflection turns with the smooth normal (the depth buffer's normal is flat per triangle: a sphere's reflection
		// would be a mosaic of its facets). Where the two disagree a lot (an edge), the depth normal is kept.
		vec3 ns = mat3(P.cam_to_world) * normalize(texelFetch(smooth_tex, p, 0).xyz * 2.0 - 1.0);
		if (!(dot(ns, nw) > 0.5)) {
			ns = nw;
		}
		vec3 r = reflect(-v, ns);
		// Fresnel (Schlick): dielectrics reflect 4 % head-on and more at grazing angles; metals reflect their own colour.
		vec3 base = textureLod(base_tex, muvw, 0.0).rgb;
		vec3 f0 = mix(vec3(0.04), base, metallic);
		vec3 fresnel = f0 + (1.0 - f0) * pow(1.0 - clamp(dot(ns, v), 0.0, 1.0), 5.0);
		// Rough surfaces blur their reflection: the rays leave in a cone round the mirror direction, as wide as roughness^2 (the
		// width of the GGX lobe). The probes, the voxels and the picture are read along one direction of that cone, a new one
		// every frame, so the anti-aliasing averages the cone over a few frames.
		int flags = int(P.screen.w + 0.5);
		float spread = rough * rough * 0.9;
		vec3 t1 = normalize(cross(r, abs(r.y) < 0.9 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0)));
		vec3 t2 = cross(r, t1);
		float ang = hash12(seed + 5.3) * 6.2831853;
		float rad_j = sqrt(hash12(seed + 7.9));
		vec3 rj = normalize(r + (t1 * cos(ang) + t2 * sin(ang)) * spread * rad_j);
		if (dot(rj, ns) < 0.05) {
			rj = r;
		}
		vec3 refl = probe_blend_dir(pw, nw, rj, a0);
		// On screen: the picture itself (sharpest). Off screen: through the voxels (sharper than the probes, as blocky as the
		// voxels), only for smooth surfaces and only where the picture did not have it.
		float found = 0.0;
		vec3 sharp = vec3(0.0);
		if ((flags & 32) != 0 && rough < 0.55) {
			mat3 to_view = transpose(mat3(P.cam_to_world));
			vec4 sr = screen_reflection(vpos, to_view * ns, normalize(to_view * rj), j0);
			sharp = sr.rgb;
			found = sr.a * (1.0 - smoothstep(0.3, 0.55, rough));
		}
		if ((flags & 1024) != 0 && rough < 0.35 && found < 0.95) {
			vec4 vr = voxel_reflection(pw + nw * P.vol_min.w * 0.5, rj);
			float w = vr.a * (1.0 - smoothstep(0.2, 0.35, rough));
			refl = mix(refl, vr.rgb, w);
		}
		refl = mix(refl, sharp, found);
		spec = fresnel * refl * mix(1.0, 0.3, rough / 0.85);
	}
	imageStore(spec_img, p, vec4(spec, metallic));
}
