// One thread = one triangle of one mesh surface: writes its albedo into every voxel it touches.
// The same test as voxelize.comp, but the triangles come straight from the meshes' world-space vertex and index arrays,
// so the CPU never has to unpack them one by one.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 1, rgba8) uniform restrict writeonly image3D vox_albedo;
layout(set = 0, binding = 2, rgba16f) uniform restrict writeonly image3D vox_emit; // emission rgb, a = 1 where emissive
layout(set = 0, binding = 3, rgba8) uniform restrict writeonly image3D vox_mat; // metallic, roughness, -, 1 = surface
layout(set = 0, binding = 4, rgba8) uniform restrict writeonly image3D vox_base; // base colour (what a metal reflects with)
layout(set = 0, binding = 8, rgba8) uniform restrict writeonly image3D vox_tint; // see-through surfaces: the colour they let through
layout(set = 0, binding = 10, r32ui) uniform restrict uimage3D emit_w; // per voxel: the largest coverage of a glowing triangle
layout(set = 0, binding = 7, r32i) uniform restrict iimage3D vox_wind; // winding-number steps along +x (fill_solid.comp)
layout(set = 0, binding = 5, std430) restrict readonly buffer Verts {
	float v[]; // world-space positions, x y z packed
} verts;
layout(set = 0, binding = 9, std430) restrict readonly buffer Colors {
	vec4 c[]; // vertex colours (linear) of the surfaces that use them; pc.a.w = first one + 1
} colors;
layout(set = 0, binding = 6, std430) restrict readonly buffer Indices {
	uint i[]; // per surface, relative to its first vertex
} indices;

layout(push_constant, std430) uniform Surface {
	vec4 a;        // triangle count, first index, first vertex, first vertex colour + 1 (0 = the surface's albedo)
	vec4 albedo;   // rgb
	vec4 emission; // rgb (colour x energy), 0 = not emissive
	vec4 mat;      // metallic, roughness, transparent (1 = see-through: not voxelized, light passes), closed mesh (1 = fill inside)
} pc;

bool axis_separates(vec3 axis, vec3 v0, vec3 v1, vec3 v2, vec3 h) {
	float p0 = dot(v0, axis);
	float p1 = dot(v1, axis);
	float p2 = dot(v2, axis);
	float r = h.x * abs(axis.x) + h.y * abs(axis.y) + h.z * abs(axis.z);
	return max(max(p0, p1), p2) < -r || min(min(p0, p1), p2) > r;
}

// Akenine-Moller triangle / box overlap (box centred at c with half size h).
bool tri_box_overlap(vec3 c, vec3 h, vec3 a, vec3 b, vec3 d) {
	vec3 v0 = a - c;
	vec3 v1 = b - c;
	vec3 v2 = d - c;
	vec3 e0 = v1 - v0;
	vec3 e1 = v2 - v1;
	vec3 e2 = v0 - v2;
	vec3 ex = vec3(1.0, 0.0, 0.0);
	vec3 ey = vec3(0.0, 1.0, 0.0);
	vec3 ez = vec3(0.0, 0.0, 1.0);
	if (axis_separates(cross(ex, e0), v0, v1, v2, h)) return false;
	if (axis_separates(cross(ex, e1), v0, v1, v2, h)) return false;
	if (axis_separates(cross(ex, e2), v0, v1, v2, h)) return false;
	if (axis_separates(cross(ey, e0), v0, v1, v2, h)) return false;
	if (axis_separates(cross(ey, e1), v0, v1, v2, h)) return false;
	if (axis_separates(cross(ey, e2), v0, v1, v2, h)) return false;
	if (axis_separates(cross(ez, e0), v0, v1, v2, h)) return false;
	if (axis_separates(cross(ez, e1), v0, v1, v2, h)) return false;
	if (axis_separates(cross(ez, e2), v0, v1, v2, h)) return false;
	if (max(max(v0.x, v1.x), v2.x) < -h.x || min(min(v0.x, v1.x), v2.x) > h.x) return false;
	if (max(max(v0.y, v1.y), v2.y) < -h.y || min(min(v0.y, v1.y), v2.y) > h.y) return false;
	if (max(max(v0.z, v1.z), v2.z) < -h.z || min(min(v0.z, v1.z), v2.z) > h.z) return false;
	vec3 n = cross(e0, e1);
	return abs(dot(n, v0)) <= h.x * abs(n.x) + h.y * abs(n.y) + h.z * abs(n.z);
}

// Edge function of the point p against the edge a -> b in the (y, z) plane.
float edge_fn(vec2 a, vec2 b, vec2 p) {
	return (b.x - a.x) * (p.y - a.y) - (b.y - a.y) * (p.x - a.x);
}

// Top-left rule: of two triangles sharing an edge, exactly one claims a point that lies on it.
bool owns(vec2 a, vec2 b, float e) {
	vec2 d = b - a;
	return e > 0.0 || (e == 0.0 && (d.y > 0.0 || (d.y == 0.0 && d.x < 0.0)));
}

// For a closed mesh: every column of voxels (along x) whose centre line crosses the triangle gets a +1 where the line enters the
// mesh and a -1 where it leaves (from the side the triangle faces). fill_solid.comp sums them along x: the voxels where the
// sum is not 0 are inside. Touching or overlapping closed meshes add up correctly.
void winding_steps(vec3 a, vec3 b, vec3 c, ivec3 dims) {
	// Godot's front faces are clockwise, so the outward normal is the opposite of cross(b - a, c - a).
	float nx = -cross(b - a, c - a).x;
	if (abs(nx) < 1e-9) {
		return; // parallel to x: the centre lines never cross it
	}
	int step = nx < 0.0 ? 1 : -1; // facing -x: the line enters here
	vec3 tb = b;
	vec3 tc = c;
	if (edge_fn(a.yz, b.yz, c.yz) < 0.0) { // counter-clockwise in (y, z), whichever way the triangle faces
		tb = c;
		tc = b;
	}
	vec2 A = a.yz;
	vec2 B = tb.yz;
	vec2 C = tc.yz;
	float area = edge_fn(A, B, C);
	// The centre lines are moved off the half-voxel grid by a tiny amount, so a mesh edge never lies exactly on one.
	const vec2 OFS = vec2(0.5 + 0.00137, 0.5 + 0.00291);
	ivec2 lo = max(ivec2(floor(min(min(A, B), C) - OFS)) + 1, ivec2(0));
	ivec2 hi = min(ivec2(floor(max(max(A, B), C) - OFS)), dims.yz - 1);
	for (int z = lo.y; z <= hi.y; z++) {
		for (int y = lo.x; y <= hi.x; y++) {
			vec2 p = vec2(y, z) + OFS;
			float w0 = edge_fn(B, C, p);
			float w1 = edge_fn(C, A, p);
			float w2 = edge_fn(A, B, p);
			if (!(owns(B, C, w0) && owns(C, A, w1) && owns(A, B, w2))) {
				continue;
			}
			// Where the line crosses the triangle (x of the plane at p), and the first voxel whose centre is beyond it.
			float x = (w0 * a.x + w1 * tb.x + w2 * tc.x) / area;
			int k = max(int(floor(x - 0.5)) + 1, 0);
			if (k < dims.x) {
				imageAtomicAdd(vox_wind, ivec3(k, y, z), step);
			}
		}
	}
}

vec3 vertex(uint k) {
	uint j = (uint(pc.a.z) + indices.i[uint(pc.a.y) + k]) * 3u;
	return (vec3(verts.v[j], verts.v[j + 1u], verts.v[j + 2u]) - P.vol_min.xyz) / P.vol_min.w;
}

void main() {
	uint t = gl_GlobalInvocationID.x;
	if (t >= uint(pc.a.x)) {
		return;
	}
	bool see_through = pc.mat.z > 0.5; // glass: it neither blocks nor bounces light; it colours what goes through it
	vec3 albedo = pc.albedo.rgb;
	if (pc.a.w > 0.5) {
		uint cb = uint(pc.a.w + 0.5) - 1u;
		uint ib = uint(pc.a.y) + t * 3u;
		albedo = (colors.c[cb + indices.i[ib]].rgb + colors.c[cb + indices.i[ib + 1u]].rgb + colors.c[cb + indices.i[ib + 2u]].rgb) / 3.0;
	}
	// A metal has no diffuse colour: what it reflects is specular, so it bounces no diffuse light.
	vec3 diffuse = albedo * (1.0 - pc.mat.x);
	vec3 a = vertex(t * 3u);
	vec3 b = vertex(t * 3u + 1u);
	vec3 c = vertex(t * 3u + 2u);
	ivec3 dims = ivec3(P.vol_dims.xyz);
	if (pc.mat.w > 0.5 && !see_through) {
		winding_steps(a, b, c, dims);
	}
	vec3 lo_f = min(min(a, b), c);
	vec3 hi_f = max(max(a, b), c);
	if (any(greaterThan(lo_f, vec3(dims))) || any(lessThan(hi_f, vec3(0.0)))) {
		return; // outside the volume
	}
	ivec3 lo = clamp(ivec3(floor(lo_f)), ivec3(0), dims - 1);
	ivec3 hi = clamp(ivec3(floor(hi_f)), ivec3(0), dims - 1);
	// A glowing surface smaller than a voxel would light the scene as if it filled the voxel (an 18 cm traffic-light lens in
	// 25 cm voxels glowed like a lens twice its size). Its emission is scaled by how much of the voxels it touches it really
	// covers: its area (in voxel faces) over the voxels it touches in one layer (the conservative test touches a ring of voxels
	// round the edges too: the 1.5 allows for that, so a large panel keeps its full emission).
	vec3 emission = pc.emission.rgb;
	float cover = 1.0;
	if (dot(emission, vec3(1.0)) > 0.0) {
		vec3 nrm = cross(b - a, c - a);
		float area = 0.5 * length(nrm);
		vec3 an = abs(nrm);
		int axis = an.x > an.y ? (an.x > an.z ? 0 : 2) : (an.y > an.z ? 1 : 2);
		float layers = float(hi[axis] - lo[axis] + 1);
		float touched = 0.0;
		for (int z = lo.z; z <= hi.z; z++) {
			for (int y = lo.y; y <= hi.y; y++) {
				for (int x = lo.x; x <= hi.x; x++) {
					touched += tri_box_overlap(vec3(x, y, z) + 0.5, vec3(0.5), a, b, c) ? 1.0 : 0.0;
				}
			}
		}
		cover = clamp(1.5 * area * layers / max(touched, 1.0), 0.0, 1.0);
	}
	for (int z = lo.z; z <= hi.z; z++) {
		for (int y = lo.y; y <= hi.y; y++) {
			for (int x = lo.x; x <= hi.x; x++) {
				if (tri_box_overlap(vec3(x, y, z) + 0.5, vec3(0.5), a, b, c)) {
					if (see_through) {
						imageStore(vox_tint, ivec3(x, y, z), vec4(albedo, 1.0));
						continue;
					}
					imageStore(vox_albedo, ivec3(x, y, z), vec4(diffuse, 1.0));
					imageStore(vox_mat, ivec3(x, y, z), vec4(pc.mat.x, pc.mat.y, 0.0, 1.0));
					imageStore(vox_base, ivec3(x, y, z), vec4(albedo, 1.0));
					if (dot(pc.emission.rgb, vec3(1.0)) > 0.0) {
						imageStore(vox_emit, ivec3(x, y, z), vec4(emission, 1.0));
						// The voxel keeps the largest coverage of the triangles that touch it (a thin face must not dim a wide one);
						// fill_solid.comp applies it.
						imageAtomicMax(emit_w, ivec3(x, y, z), uint(cover * 65535.0));
					}
				}
			}
		}
	}
}
