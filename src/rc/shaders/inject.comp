// One thread = one voxel: direct light (omni / directional, shadowed through the voxels) on solid voxels.
// vox_rad = albedo * sum(light * cos * attenuation). Godot's convention: no 1/pi.

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 0, binding = 1, rgba8) uniform restrict readonly image3D vox_albedo;
layout(set = 0, binding = 3, rgba16f) uniform restrict writeonly image3D vox_rad;
layout(set = 0, binding = 16) uniform sampler3D dyn_tex; // moving objects only (their own volume), trilinear: alpha = coverage 0..1
layout(set = 0, binding = 21, rgba8) uniform restrict readonly image3D vox_dyn; // moving objects: albedo + coverage
layout(set = 0, binding = 14) uniform sampler3D occ_tex; // static voxels, trilinear: alpha = occupancy 0..1
layout(set = 0, binding = 22, rgba16f) uniform restrict readonly image3D amb_img; // last frame's ambient cubes (ambient.comp)
layout(set = 0, binding = 23, rgba16f) uniform restrict readonly image3D emit_img; // emission of the static surfaces (rgb, a = emissive)
layout(set = 0, binding = 24, rgba16f) uniform restrict readonly image3D dyn_emit_img; // emission of the moving objects
layout(set = 0, binding = 4, std430) restrict readonly buffer Lights {
	vec4 l[]; // per light: (pos, range), (color*energy, type 0=omni 1=directional), (dir to light, decay)
} lights;

//#include trace.inc

layout(push_constant, std430) uniform Region {
	vec4 o; // xyz: first voxel of the region being re-lit (the dispatch covers the region only); w: next-bounce gain (0 = one bounce)
	vec4 b; // x: emission scale
} region;

// The next bounce: the irradiance last frame's probes saw around this point, for a surface facing n. The 8 probes around the
// point are blended like a trilinear lookup, but a probe inside a wall or behind the surface does not count.
vec3 ambient_at(vec3 pos, vec3 n) {
	float sp = P.misc.x;
	ivec3 grid = grid_of(sp);
	vec3 qf = (pos - P.vol_min.xyz) / sp - 0.5;
	ivec3 q0 = ivec3(floor(qf));
	vec3 fr = qf - vec3(q0);
	vec3 n2 = n * n;
	vec3 acc = vec3(0.0);
	float ws = 0.0;
	for (int k = 0; k < 8; k++) {
		ivec3 o = ivec3(k & 1, (k >> 1) & 1, k >> 2);
		ivec3 q = q0 + o;
		if (any(lessThan(q, ivec3(0))) || any(greaterThanEqual(q, grid))) {
			continue;
		}
		vec3 qpos = P.vol_min.xyz + (vec3(q) + 0.5) * sp;
		vec3 quvw = (qpos - P.vol_min.xyz) / (P.vol_dims.xyz * P.vol_min.w);
		float open = 1.0 - clamp(textureLod(occ_tex, quvw, 0.0).a * OCC_GAIN, 0.0, 1.0);
		float front = smoothstep(-0.2, 0.3, dot(normalize(qpos - pos + n * 1e-3), n));
		float w = (o.x == 1 ? fr.x : 1.0 - fr.x) * (o.y == 1 ? fr.y : 1.0 - fr.y) * (o.z == 1 ? fr.z : 1.0 - fr.z) * open * front;
		if (w < 1e-4) {
			continue;
		}
		vec3 e = n2.x * imageLoad(amb_img, ivec3(q.x * 6 + (n.x > 0.0 ? 0 : 1), q.y, q.z)).rgb
			+ n2.y * imageLoad(amb_img, ivec3(q.x * 6 + (n.y > 0.0 ? 2 : 3), q.y, q.z)).rgb
			+ n2.z * imageLoad(amb_img, ivec3(q.x * 6 + (n.z > 0.0 ? 4 : 5), q.y, q.z)).rgb;
		acc += w * e;
		ws += w;
	}
	return ws > 1e-3 ? acc / ws : vec3(0.0);
}

bool solid2(ivec3 c) {
	return solid_cell(c) || imageLoad(vox_dyn, c).a > 0.5;
}

// Fraction of the light that gets through the MOVING objects between t_a and t_b, marching their own trilinear coverage
// volume: the edge of a shadow cast by an object that moves moves smoothly.
float soft_march(vec3 o, vec3 l, float t_a, float t_b) {
	float step_len = P.vol_min.w * 0.75;
	vec3 extent = P.vol_dims.xyz * P.vol_min.w;
	float T = 1.0;
	for (float t = t_a + step_len * 0.5; t < t_b; t += step_len) {
		vec3 uvw = (o + l * t - P.vol_min.xyz) / extent;
		if (any(lessThan(uvw, vec3(0.0))) || any(greaterThan(uvw, vec3(1.0)))) {
			break;
		}
		T *= 1.0 - clamp(textureLod(dyn_tex, uvw, 0.0).a * OCC_GAIN, 0.0, 1.0);
		if (T < 0.01) {
			return 0.0;
		}
	}
	return T;
}

// Light that reaches o from direction l over a distance `stop`: the exact voxel walk through the static geometry, times the soft
// transmittance of the moving objects (only where the ray crosses their bounds). The two layers are independent, so the result
// is continuous when an object moves: there is no switch between two ways of computing the shadow.
float shadow(vec3 o, vec3 l, float stop) {
	ivec3 hc;
	bool lv;
	if (dda(o, l, 0.0, stop, hc, lv)) {
		return 0.0;
	}
	if (P.dyn_min.w > 0.5) {
		vec3 invd = 1.0 / (l + vec3(equal(l, vec3(0.0))) * 1e-8);
		vec3 ta = (P.dyn_min.xyz - o) * invd;
		vec3 tb = (P.dyn_max.xyz - o) * invd;
		vec3 tlo = min(ta, tb);
		vec3 thi = max(ta, tb);
		float t_in = max(max(max(tlo.x, tlo.y), tlo.z), 0.0);
		float t_out = min(min(min(thi.x, thi.y), thi.z), stop);
		if (t_in < t_out) {
			return soft_march(o, l, t_in, t_out);
		}
	}
	return 1.0;
}

void main() {
	ivec3 c = ivec3(gl_GlobalInvocationID) + ivec3(region.o.xyz);
	if (!in_vol(c)) {
		return;
	}
	vec4 sa = imageLoad(vox_albedo, c);
	vec4 da = imageLoad(vox_dyn, c);
	vec4 alb = da.a > sa.a ? da : sa;
	if (alb.a < 0.02) { // partly covered voxels (the edge of a moving box) carry light too
		imageStore(vox_rad, c, vec4(0.0));
		return;
	}
	bool near_empty = false;
	for (int k = 0; k < 27 && !near_empty; k++) {
		ivec3 nc = c + ivec3(k % 3 - 1, (k / 3) % 3 - 1, k / 9 - 1);
		near_empty = !in_vol(nc) || !solid2(nc);
	}
	if (!near_empty) {
		imageStore(vox_rad, c, vec4(0.0));
		return;
	}
	// Surface normal = direction towards the empty neighbours, radius 2, closer ones count more
	// (a wider kernel keeps the voxel staircase of a curved wall from turning into a noisy normal).
	vec3 n = vec3(0.0);
	bool any_empty = false;
	for (int dz = -2; dz <= 2; dz++) {
		for (int dy = -2; dy <= 2; dy++) {
			for (int dx = -2; dx <= 2; dx++) {
				if (dx == 0 && dy == 0 && dz == 0) {
					continue;
				}
				ivec3 nc = c + ivec3(dx, dy, dz);
				if (!in_vol(nc) || !solid2(nc)) {
					vec3 o = vec3(dx, dy, dz);
					n += o / (1.0 + dot(o, o));
					if (abs(dx) <= 1 && abs(dy) <= 1 && abs(dz) <= 1) {
						any_empty = true;
					}
				}
			}
		}
	}
	if (!any_empty || dot(n, n) < 1e-6) {
		imageStore(vox_rad, c, vec4(0.0));
		return;
	}
	n = normalize(n);
	float vs = P.vol_min.w;
	vec3 center = P.vol_min.xyz + (vec3(c) + 0.5) * vs;
	vec3 pos = center + n * vs * 1.0;
	// Shadow rays start well off the surface: on a voxelized curved wall they would otherwise graze the
	// neighbouring steps and shadow voxels that are really lit (shadow acne, which shows up as stripes).
	vec3 spos = center + n * vs * 2.4;
	vec3 direct = vec3(0.0);
	int count = int(P.vol_dims.w);
	for (int i = 0; i < count; i++) {
		vec4 a = lights.l[i * 3];
		vec4 b = lights.l[i * 3 + 1];
		vec4 d = lights.l[i * 3 + 2];
		vec3 l;
		float dist;
		float atten = 1.0;
		if (b.w < 0.5) {
			vec3 to = a.xyz - pos;
			dist = length(to);
			if (dist > a.w || dist < 1e-3) {
				continue;
			}
			l = to / dist;
			float nd = dist / a.w;
			nd *= nd;
			nd *= nd;
			nd = max(1.0 - nd, 0.0);
			atten = nd * nd * pow(max(dist, 1e-4), -d.w);
		} else {
			l = normalize(d.xyz);
			dist = 80.0;
		}
		float cosv = max(dot(n, l), 0.0);
		if (cosv <= 0.0) {
			continue;
		}
		float stop = b.w < 0.5 ? max(dist - 0.5, 0.0) : dist;
		float lit = shadow(spos, l, stop);
		if (lit <= 0.0) {
			continue;
		}
		direct += b.rgb * (cosv * atten * lit);
	}
	vec3 bounce = region.o.w > 0.0 ? region.o.w * min(ambient_at(pos, n), vec3(P.tune.z)) : vec3(0.0);
	vec4 em = imageLoad(emit_img, c);
	vec4 dem = imageLoad(dyn_emit_img, c);
	vec3 emission = ((em.a > 0.5 ? em.rgb : vec3(0.0)) + (dem.a > 0.5 ? dem.rgb : vec3(0.0))) * region.b.x;
	imageStore(vox_rad, c, vec4(alb.rgb * (direct + bounce) + emission, 1.0));
}
