// Per pixel: world position + normal from the depth buffer, irradiance from the 8 nearest world-space
// cascade-0 probes (visibility- and facing-weighted), albedo from the voxel under the pixel.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 1, rgba8) uniform restrict readonly image3D vox_albedo;
layout(set = 0, binding = 8) uniform sampler2D depth_tex;
layout(set = 0, binding = 9, rgba16f) uniform restrict image2D color_img;
layout(set = 0, binding = 10, rgba16f) uniform restrict readonly image3D c0_img;
layout(set = 0, binding = 11) uniform sampler2D albedo_tex; // unshaded albedo render, sRGB encoded

layout(push_constant, std430) uniform Gather {
	vec4 a; // a_0, unused, unused, unused
} pc;

//#include trace.inc

vec3 srgb_to_linear(vec3 c) {
	return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), c));
}

vec3 view_pos(ivec2 p, float d) {
	vec2 uv = (vec2(p) + 0.5) / P.screen.xy;
	vec4 v = P.inv_proj * vec4(uv * 2.0 - 1.0, d, 1.0);
	return v.xyz / v.w;
}

vec3 pos_at(ivec2 p) {
	ivec2 q = clamp(p, ivec2(0), ivec2(P.screen.xy) - 1);
	return view_pos(q, texelFetch(depth_tex, q, 0).r);
}

vec3 normal_view(ivec2 p, vec3 c) {
	vec3 xp = pos_at(p + ivec2(1, 0));
	vec3 xm = pos_at(p - ivec2(1, 0));
	vec3 yp = pos_at(p + ivec2(0, 1));
	vec3 ym = pos_at(p - ivec2(0, 1));
	vec3 dx = abs(xp.z - c.z) < abs(xm.z - c.z) ? xp - c : c - xm;
	vec3 dy = abs(yp.z - c.z) < abs(ym.z - c.z) ? yp - c : c - ym;
	vec3 n = normalize(cross(dx, dy));
	return dot(n, c) > 0.0 ? -n : n;
}

vec3 irradiance(ivec3 probe, int a0, vec3 n) {
	vec3 acc = vec3(0.0);
	float wsum = 0.0;
	for (int j = 0; j < a0; j++) {
		for (int i = 0; i < a0; i++) {
			vec3 v = oct_vec(ivec2(i, j), a0);
			float w = pow(dot(v, v), -1.5);
			float c = max(dot(normalize(v), n), 0.0);
			acc += imageLoad(c0_img, ivec3(probe.x * a0 + i, probe.y * a0 + j, probe.z)).rgb * (c * w);
			wsum += w;
		}
	}
	return 4.0 * acc / wsum;
}

void main() {
	ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	ivec2 sz = ivec2(P.screen.xy);
	if (any(greaterThanEqual(p, sz))) {
		return;
	}
	float d = texelFetch(depth_tex, p, 0).r;
	if (d <= SKY_DEPTH) {
		return;
	}
	vec3 vpos = view_pos(p, d);
	vec3 nv = normal_view(p, vpos);
	vec3 pw = (P.cam_to_world * vec4(vpos, 1.0)).xyz;
	vec3 nw = normalize(mat3(P.cam_to_world) * nv);
	float vs = P.vol_min.w;

	// Albedo of the nearest solid voxel around the pixel (3x3x3 search, so a voxel staircase cannot pick the wrong one).
	vec3 vox_a = vec3(-1.0);
	{
		vec3 inside = pw - nw * vs * 0.5;
		ivec3 c0 = cell_of(inside);
		float best = 1e9;
		for (int dz = -1; dz <= 1; dz++) {
			for (int dy = -1; dy <= 1; dy++) {
				for (int dx = -1; dx <= 1; dx++) {
					ivec3 vc = c0 + ivec3(dx, dy, dz);
					if (!in_vol(vc)) {
						continue;
					}
					vec4 va = imageLoad(vox_albedo, vc);
					if (va.a < 0.5) {
						continue;
					}
					vec3 center = P.vol_min.xyz + (vec3(vc) + 0.5) * vs;
					vec3 dd = center - pw;
					if (dot(dd, nw) > 0.3 * vs) {
						continue; // a voxel in front of the surface belongs to another surface (the wall next to a floor pixel)
					}
					// Prefer the voxel right behind the pixel (about half a voxel under the surface, little sideways offset).
					float along = dot(dd, nw) + 0.5 * vs;
					vec3 side = dd - nw * dot(dd, nw);
					float d2 = along * along * 4.0 + dot(side, side);
					if (d2 < best) {
						best = d2;
						vox_a = va.rgb;
					}
				}
			}
		}
	}

	int a0 = int(pc.a.x + 0.5);
	float sp = P.misc.x;
	ivec3 grid = grid_of(sp);
	vec3 start = pw + nw * P.misc.z;
	vec3 qf = (start - P.vol_min.xyz) / sp - 0.5;
	ivec3 q0 = ivec3(floor(qf));
	vec3 fr = qf - vec3(q0);
	vec3 acc = vec3(0.0);
	float wsum = 0.0;
	float wsum0 = -1.0;
	int nvalid = 0;
	// Pass 0 checks that the pixel can see each probe; if every probe is rejected (a pixel in a voxel staircase
	// corner), pass 1 skips that check rather than leave the pixel black.
	vec3 vis_start = pw + nw * max(vs * 1.6, 0.08);
	for (int pass = 0; pass < 2 && wsum <= 0.0; pass++) {
		if (pass == 1) {
			wsum0 = wsum;
		}
		for (int k = 0; k < 8; k++) {
			ivec3 o = ivec3(k & 1, (k >> 1) & 1, k >> 2);
			ivec3 qp = q0 + o;
			if (any(lessThan(qp, ivec3(0))) || any(greaterThanEqual(qp, grid))) {
				continue;
			}
			vec3 qpos = P.vol_min.xyz + (vec3(qp) + 0.5) * sp;
			if (solid_at(qpos)) {
				continue;
			}
			if (pass == 0) {
				vec3 dv = qpos - vis_start;
				float dl = length(dv);
				// Ignore the first 2 voxels of the path: that is where the steps of a voxelized wall stick out
				// past the real surface and would block every probe for a pixel standing next to the wall.
				float skip = 3.0 * vs;
				if (dl > skip + 1e-3) {
					ivec3 hc;
					bool lv;
					if (dda(vis_start, dv / dl, skip, dl, hc, lv)) {
						continue;
					}
				}
			}
			float bw = (o.x == 1 ? fr.x : 1.0 - fr.x) * (o.y == 1 ? fr.y : 1.0 - fr.y) * (o.z == 1 ? fr.z : 1.0 - fr.z);
			float face = dot(normalize(qpos - pw), nw);
			float w = bw * (pow((face + 1.0) * 0.5, 2.0) + 0.02);
			acc += w * irradiance(qp, a0, nw);
			wsum += w;
			nvalid++;
		}
	}
	vec3 gi = wsum > 0.0 ? acc / wsum : vec3(0.0);

	vec4 col = imageLoad(color_img, p);
	vec3 albedo;
	if (P.misc.w > 0.5) {
		albedo = srgb_to_linear(texelFetch(albedo_tex, p, 0).rgb);
	} else if (vox_a.r >= 0.0) {
		albedo = vox_a;
	} else {
		float luma = dot(col.rgb, vec3(0.2126, 0.7152, 0.0722));
		albedo = luma > 1e-4 ? clamp(col.rgb / luma * P.tune.y, 0.0, 1.0) : vec3(P.tune.y);
	}
	vec3 indirect = gi * albedo * P.tune.x;
	if (P.tune.w > 2.5) {
		// debug 3: R = fallback pass used, G = valid probes / 8, B = start point inside a solid voxel
		col.rgb = vec3(wsum0 >= 0.0 ? 1.0 : 0.0, float(nvalid) / 8.0, solid_at(vis_start) ? 1.0 : 0.0);
	} else if (P.tune.w > 1.5) {
		col.rgb = albedo; // debug: voxel albedo under the pixel (checks the camera transform)
	} else if (P.tune.w > 0.5) {
		col.rgb = indirect;
	} else {
		col.rgb += indirect;
	}
	imageStore(color_img, p, col);
}
